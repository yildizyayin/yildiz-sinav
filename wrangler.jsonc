{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yildiz-sinav-v1",
  "main": "./worker/privacy-entry.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "queues": {
    "producers": [
      {
        "binding": "SCALE_QUEUE",
        "queue": "yildiz-sinav-scale-staging"
      }
    ],
    "consumers": [
      {
        "queue": "yildiz-sinav-scale-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "yildiz-sinav-scale-staging-dlq"
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "PRODUCT_NAME": "Anunex — Nibiru AI Destekli Ölçme ve Analiz Platformu",
    "NIBIRU_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "NIBIRU_AI_GATEWAY_ID": "default",
    "NIBIRU_STT_MODEL": "@cf/openai/whisper-large-v3-turbo",
    "NIBIRU_GOOGLE_TTS_VOICE": "tr-TR-Wavenet-E",
    "NIBIRU_OPENAI_TTS_MODEL": "openai/tts-1",
    "NIBIRU_OPENAI_TTS_HD_MODEL": "openai/tts-1-hd",
    "NIBIRU_OPENAI_DIRECT_TTS_MODEL": "gpt-4o-mini-tts",
    "NIBIRU_OPENAI_TTS_VOICE": "alloy",
    "WHATSAPP_GRAPH_API_VERSION": "v25.0",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA"
  }
}
