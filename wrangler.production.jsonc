{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yildiz-sinav-prod",
  "main": "./worker/preview-policy-production-entry.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "QUESTION_AUTOMATED_ACADEMIC_YEAR": "2027-2028",
    "QUESTION_AUTOMATED_PILOT_MODE": "true",
    "QUESTION_AGENT_DISPATCH_PREVIEW": "true",
    "QUESTION_AGENT_EXECUTION_ENABLED": "true",
    "QUESTION_AGENT_SERVICE_ACTOR_ID": "svc-soru-ajani",
    "QUESTION_PILOT_REVIEW_AVAILABLE": "true",
    "QUESTION_PILOT_REVIEW_SLOTS": "10000",
    "QUESTION_TEAM_CONTROLS_ENABLED": "true",
    "QUESTION_VIDEO_RENDER_ENABLED": "true",
    "ENVIRONMENT": "production",
    "PRODUCT_NAME": "Anunex — Nibiru AI Destekli Ölçme ve Analiz Platformu",
    "NIBIRU_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "WHATSAPP_GRAPH_API_VERSION": "v25.0",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000BB",
    "QUESTION_GENERATION_ENABLED": "true",
    "QUESTION_GENERATION_MODEL": "@cf/zai-org/glm-4.7-flash",
    "QUESTION_GENERATION_MODEL_CANDIDATES": "@cf/zai-org/glm-4.7-flash,@cf/openai/gpt-oss-120b",
    "QUESTION_GENERATION_VERIFICATION_ENABLED": "true",
    "QUESTION_GENERATION_STRUCTURED_OUTPUT_ENABLED": "true",
    "QUESTION_GENERATION_VERIFIER_MODEL": "@cf/nvidia/nemotron-3-120b-a12b"
  },
  "keep_vars": true
}
