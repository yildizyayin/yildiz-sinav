{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yildiz-sinav-prod",
  "main": "./worker/preview-policy-production-entry.ts",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  },
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    },
    {
      "binding": "REPORT_EXPORT_FILES",
      "bucket_name": "anunex-report-exports-production"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ENVIRONMENT": "production",
    "PRODUCT_NAME": "Anunex — Nibiru AI Destekli Ölçme ve Analiz Platformu",
    "NIBIRU_AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "WHATSAPP_GRAPH_API_VERSION": "v25.0",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000BB",
    "REPORT_EXPORTS_ENABLED": "true",
    "COHORT_REPORTS_ENABLED": "true",
    "REPORT_EXPORT_QUEUE_NAME": "anunex-rubric-exports-production",
    "COHORT_REPORT_QUEUE_NAME": "anunex-cohort-reports-production"
  },
  "queues": {
    "producers": [
      {
        "binding": "REPORT_EXPORT_QUEUE",
        "queue": "anunex-rubric-exports-production"
      },
      {
        "binding": "COHORT_REPORT_QUEUE",
        "queue": "anunex-cohort-reports-production"
      }
    ],
    "consumers": [
      {
        "queue": "anunex-rubric-exports-production",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "anunex-rubric-exports-production-dlq"
      },
      {
        "queue": "anunex-cohort-reports-production",
        "max_batch_size": 5,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "anunex-cohort-reports-production-dlq"
      }
    ]
  }
}
